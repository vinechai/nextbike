# local docker postgres — for running notebooks and training
LOCAL_DATABASE_URL=postgresql://nextbike:nextbike@localhost:5432/nextbike

# supabase — live scraper data, used by the api
# get it from: supabase project -> connect -> transaction pooler -> connection string
SUPABASE_DATABASE_URL=postgresql://postgres.<project-ref>:[YOUR-PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# docker-compose reads these to set up the local postgres container
POSTGRES_USER=nextbike
POSTGRES_PASSWORD=nextbike
POSTGRES_DB=nextbike
POSTGRES_PORT=5432

# pgadmin — optional, for browsing the local db at http://localhost:5050
PGADMIN_EMAIL=admin@nextbike.local
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050
